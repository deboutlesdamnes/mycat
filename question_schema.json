{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GeneratedMCATQuestion",
  "description": "A structured MCAT-style practice question.",
  "type": "object",
  "required": [
    "id", "section", "subject", "topic", "knowledge_point",
    "type", "skill", "subtype", "question", "options", "correct", "explanation"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "section": { "type": "string", "minLength": 1 },
    "subject": { "type": "string", "minLength": 1 },
    "topic": { "type": "string", "minLength": 1 },
    "knowledge_point": { "type": "string", "minLength": 1 },
    "type": { "enum": ["discrete", "passage"] },
    "skill": {
      "enum": ["skill1", "skill2", "skill3", "skill4", "cars-foc", "cars-rwt", "cars-rbt"]
    },
    "subtype": { "type": "string", "minLength": 1 },
    "difficulty": { "enum": ["easy", "medium", "hard"] },
    "passage": { "type": "string" },
    "figure": { "type": "string" },
    "question": { "type": "string", "minLength": 1 },
    "options": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "string", "minLength": 1 }
    },
    "correct": { "type": "integer", "minimum": 0, "maximum": 3 },
    "explanation": { "type": "string", "minLength": 1 }
  }
}
